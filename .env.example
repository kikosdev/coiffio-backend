MONGO_URI=mongodb://localhost:27017/salonos
JWT_SECRET=change_me
JWT_EXPIRES=7d
FRONTEND_ORIGIN=http://localhost:5173
PORT=3001

# Entitlements (Sprint 1 v2, Prompt 7) — Control Plane (Sprint 3), pas encore construit.
# Laisser vide : fallback plan 'starter' actif pour tout le trafic, jamais de blocage.
CP_PUBLIC_KEY=
CP_URL=
CP_SHARED_SECRET=
# Rotation sans coupure (Delta 4, Sprint 3 v2 Prompt 9) : pendant une rotation, poser
# CP_SHARED_SECRET_PREVIOUS = l'ancien CP_SHARED_SECRET AVANT de faire tourner CP_SHARED_SECRET
# vers la nouvelle valeur côté CP et DP. InternalAuthGuard accepte l'un OU l'autre le temps de
# la transition. Retirer cette variable une fois la rotation confirmée des deux côtés.
CP_SHARED_SECRET_PREVIOUS=
# Restreint /internal/* (appels CP→DP) à une liste d'IPs, optionnel — vide = pas de restriction.
CP_ALLOWED_IPS=

# Email transactionnel (Sprint 4 Prompt 2) — Nodemailer/SMTP, requis au boot (EmailService
# refuse de démarrer si l'un manque). Gmail SMTP en dev : host smtp.gmail.com, port 465
# (secure) ou 587 (STARTTLS), USER = l'adresse Gmail, PASS = un mot de passe d'application
# (pas le mot de passe du compte). SMTP_FROM optionnel, défaut = SMTP_USER.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
